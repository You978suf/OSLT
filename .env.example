# Copy this to ".env" and fill in real values. NEVER commit the real .env
# (it is already gitignored). On a VPS, create it directly on the server.

# ── Public domain (used by Caddy for automatic HTTPS) ────────────────────────
DOMAIN=jissr.example.com

# ── Database (external MySQL — e.g. Azure MySQL Flexible Server) ──────────────
# SSL is auto-enabled when the host ends in .mysql.database.azure.com
MYSQL_HOST=your-server.mysql.database.azure.com
MYSQL_USER=jissr_admin
MYSQL_PASSWORD=change-me-and-rotate
MYSQL_DATABASE=jissr_db

# ── Model files (downloaded once from Azure Blob into the persistent volume) ──
MODEL_BLOB_URL=https://...blob.core.windows.net/.../sentences_best_11pct.pth?<SAS>
LANDMARKS_BLOB_URL=https://...blob.core.windows.net/.../landmarks.zip?<SAS>

# ── Auth / app ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
APP_BASE_URL=https://jissr.example.com   # makes password-reset links correct

# ── Optional: natural TTS/STT (ElevenLabs) ───────────────────────────────────
ELEVENLABS_API_KEY=

# ── Optional: password-reset emails (Azure Communication Services) ───────────
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# ── Chatbot (bundled Ollama — defaults already set in the Dockerfile) ────────
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:1b
